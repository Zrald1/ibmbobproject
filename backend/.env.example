# LLM provider — Cerebras (ultra-fast inference, OpenAI-compatible)
# Get a key at https://cloud.cerebras.ai
LLM_API_BASE=https://api.cerebras.ai/v1
LLM_API_KEY=
LLM_MODEL=qwen-3.8-27b
LLM_TIMEOUT_SECONDS=30

# Speech-to-text — AssemblyAI Sync STT (single-request, no polling)
# Get a key at https://www.assemblyai.com
STT_API_KEY=
STT_MODEL=universal-3-5-pro
STT_TIMEOUT_SECONDS=60
