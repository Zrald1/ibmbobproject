# ═══════════════════════════════════════════════════════════════════════
#  Argos backend configuration
#
#  Two providers are configured independently, so you can mix and match:
#    - LLM (chat)  : any OpenAI-compatible endpoint
#    - STT (voice) : OpenAI-compatible  OR  AssemblyAI
#
#  Copy this file to `.env` and fill in your keys.
# ═══════════════════════════════════════════════════════════════════════

# ── LLM (chat) — OpenAI-compatible ──────────────────────────────────────
# Just change these three values to switch provider. No code changes needed.
#
#   Cerebras (fast, free tier) :
#       LLM_API_BASE=https://api.cerebras.ai/v1
#       LLM_MODEL=qwen-3.8-27b
#       (other models: gpt-oss-120b, gemma-4-31b, zai-glm-4.7)
#
#   Groq (fast, free tier) :
#       LLM_API_BASE=https://api.groq.com/openai/v1
#       LLM_MODEL=llama-3.3-70b-versatile
#       (other models: llama-3.1-8b-instant, qwen/qwen3-32b)
#
#   OpenAI :
#       LLM_API_BASE=https://api.openai.com/v1
#       LLM_MODEL=gpt-4o-mini
#
LLM_API_BASE=https://api.cerebras.ai/v1
LLM_API_KEY=
LLM_MODEL=qwen-3.8-27b
LLM_TIMEOUT_SECONDS=30

# Hidden reasoning tokens add latency on models that support them (Cerebras
# gpt-oss). "none" keeps replies snappy. Leave BLANK to omit the field for
# providers that reject it (e.g. Groq).
LLM_REASONING_EFFORT=none


# ── STT (voice) — pick ONE provider ─────────────────────────────────────
#
#   STT_PROVIDER=openai
#       Any OpenAI-compatible /audio/transcriptions endpoint.
#       If STT_API_KEY is blank it falls back to LLM_API_KEY, so Groq needs
#       only one key for both chat and voice:
#           STT_PROVIDER=openai
#           STT_API_BASE=https://api.groq.com/openai/v1
#           STT_MODEL=whisper-large-v3-turbo
#           STT_API_KEY=            (blank → reuses LLM_API_KEY)
#
#       For OpenAI Whisper:
#           STT_PROVIDER=openai
#           STT_API_BASE=https://api.openai.com/v1
#           STT_MODEL=whisper-1
#           STT_API_KEY=
#
#   STT_PROVIDER=assemblyai
#       AssemblyAI. Needs its OWN key (never reuses LLM_API_KEY).
#       Tries the synchronous endpoint first and automatically falls back to
#       the v2 upload+poll API if sync isn't enabled on the account.
#           STT_PROVIDER=assemblyai
#           STT_API_KEY=<your assemblyai key>
#           STT_MODEL=universal-3-5-pro
#
#   STT_API_BASE is optional — sensible defaults are chosen per provider:
#       openai     → https://api.groq.com/openai/v1
#       assemblyai → https://sync.assemblyai.com
#
STT_PROVIDER=assemblyai
STT_API_KEY=
STT_MODEL=universal-3-5-pro
STT_API_BASE=
STT_LANGUAGE=en
STT_TIMEOUT_SECONDS=60


# ── Example combinations ────────────────────────────────────────────────
#
#   Cerebras chat + AssemblyAI voice  (current default above)
#   Groq chat + Groq voice            (single Groq key)
#   Cerebras chat + Groq voice        (two keys, fastest mix)
