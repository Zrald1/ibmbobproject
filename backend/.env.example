# LLM provider — Groq (free, no credit card, OpenAI-compatible)
# Get a free key at https://console.groq.com
LLM_API_BASE=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=30

# Speech-to-text — Groq Whisper, same account/key as above.
# Leave blank to reuse LLM_API_BASE / LLM_API_KEY.
STT_API_BASE=
STT_API_KEY=
STT_MODEL=whisper-large-v3
STT_TIMEOUT_SECONDS=60
