<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext permitted app-wide: the Argos backend and the desktop link
         are plain HTTP on LAN/private hosts (e.g. http://<desktop-ip>:47830
         and the configured backend URL). Pairing tokens are the auth layer;
         HTTPS endpoints still negotiate TLS normally. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
