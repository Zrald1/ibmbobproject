# ── Android ──
/android/app/build/
/android/build/
/android/.gradle/
/android/app/.cxx/
/android/app/debug/
/android/app/profile/
/android/app/release/
/android/local.properties
*.apk
*.aab
*.ap_
*.dex

# ── IDE ──
*.iml
.ipr
.iws
.idea/
.vscode/
*.swp
.DS_Store

# ── Build artifacts ──
/build/
*.log
*.pyc
__pycache__/

# ── Secrets and credentials — NEVER commit ──
*.env
.env
# Signing material must live OUTSIDE the repo (see android/local.properties,
# which is also ignored). These rules are a safety net so it can never be
# accidentally re-added.
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.key
signing/
signing.properties
keystore.properties
gcp-service-account.json
service-account.json
*access*keys*.csv
argos_config.txt
**/argos_config.txt

# ── Large binaries ──
*.bin
*.tar.gz
*.mp4

# ── Temp files ──
aria_*.txt
imgui.ini
*.tmp

# Generated signing secret blob (never commit)
argos-keystore.base64.txt
*.base64.txt
